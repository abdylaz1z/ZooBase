<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SDL/Kivy draws its navigation inside the activity. Keep system bars
         outside that surface while targeting API 35. -->
    <style name="ZooBaseTheme" parent="android:style/Theme.NoTitleBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">#143e2e</item>
        <item name="android:navigationBarColor">#143e2e</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
